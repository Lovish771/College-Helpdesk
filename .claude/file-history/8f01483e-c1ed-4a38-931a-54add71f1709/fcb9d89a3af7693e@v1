@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    -webkit-font-smoothing: antialiased;
  }

  body {
    @apply bg-paper text-ink font-sans;
  }

  * {
    @apply border-line;
  }

  :focus-visible {
    outline: 2px solid #22304a;
    outline-offset: 2px;
  }

  ::selection {
    background: #d8dfea;
  }
}

@layer utilities {
  .container-page {
    @apply max-w-content mx-auto px-5 sm:px-6 lg:px-8;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
