# Lovely Professional University Student Helpdesk Environment Configuration
# Duplicate this file to .env for local development

# Flask Backend Environment
FLASK_ENV=development
SECRET_KEY=generate-a-strong-random-key-here-for-jwt-and-session-security

# Database (Leave blank to use default SQLite database in backend/lpu_helpdesk.db)
# On Vercel, it defaults to /tmp/lpu_helpdesk.db or you can provide PostgreSQL / Supabase URI:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Admin Account Provisioning (No hardcoded credentials)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admissions@lpu.co.in
ADMIN_PASSWORD=SetYourSecureAdminPasswordHere2026!
ADMIN_EMAILS=admissions@lpu.co.in,admin@lpu.in

# Online Email Delivery Service for 6-Digit Verification OTP (Deploy Ready)
# Recommended for cloud / Vercel / serverless: Resend REST API (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=LPU Helpdesk <onboarding@resend.dev>

# Alternative Cloud Providers:
# BREVO_API_KEY=
# SENDGRID_API_KEY=

# Standard SMTP Service (e.g. Gmail App Password, AWS SES, Brevo SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend Configuration
# Leave blank in production to use relative /api routing
VITE_API_URL=http://localhost:5000
VITE_USE_MOCK=false
